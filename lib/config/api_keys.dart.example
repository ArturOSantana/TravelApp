

/// - OpenWeatherMap: https://openweathermap.org/api
/// - Geoapify: https://www.geoapify.com/get-started-with-maps-api
/// - OpenTripMap: https://opentripmap.io/product (opcional)
/// - Foursquare: https://foursquare.com/developers/apps (opcional)

class ApiKeys {
  
  /// OpenWeatherMap - Clima e Previsão do Tempo
  /// Plano gratuito: 1000 chamadas/dia
  static const String openWeatherMap = 'COLE_SUA_KEY_AQUI';
  
  /// Geoapify - Rotas, Mapas e Lugares
  /// Plano gratuito: 3000 créditos/dia
  static const String geoapify = 'COLE_SUA_KEY_AQUI';
  
  /// OpenTripMap - Pontos Turísticos (OPCIONAL)
  /// Plano gratuito: limitado
  static const String openTripMap = 'COLE_SUA_KEY_AQUI';
  
  /// Foursquare - Restaurantes e Locais (OPCIONAL)
  /// Plano gratuito: limitado
  static const String foursquare = 'COLE_SUA_KEY_AQUI';
  
  // APIs GRATUITAS (não requerem key):
  // - ExchangeRate API: https://api.exchangerate-api.com
  // - REST Countries: https://restcountries.com
  // - Nominatim (OpenStreetMap): https://nominatim.openstreetmap.org
}

/// Exemplo de uso com variáveis de ambiente (RECOMENDADO PARA PRODUÇÃO):
///
/// 1. Instale: flutter pub add flutter_dotenv
///
/// 2. Crie .env na raiz:
/// ```
/// OPENWEATHERMAP_API_KEY=sua_key_aqui
/// GEOAPIFY_API_KEY=sua_key_aqui
/// ```
///
/// 3. Adicione ao pubspec.yaml:
/// ```yaml
/// flutter:
///   assets:
///     - .env
/// ```
///
/// 4. Carregue no main.dart:
/// ```dart
/// import 'package:flutter_dotenv/flutter_dotenv.dart';
///
/// Future<void> main() async {
///   await dotenv.load(fileName: ".env");
///   runApp(MyApp());
/// }
/// ```
///
/// 5. Use no código:
/// ```dart
/// final apiKey = dotenv.env['OPENWEATHERMAP_API_KEY'] ?? '';
/// ```